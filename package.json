{
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-flow-strip-types": "^7.29.7",
    "flow-bin": "^0.340.0",
    "flow-parser": "^0.341.0",
    "parcel": "^2.16.4",
    "prettier": "3.10.1"
  },
  "scripts": {
    "flow": "flow",
    "format": "prettier src/* --write",
    "build": "flow && parcel build index.html"
  },
  "prettier": {
    "overrides": [
      {
        "files": [
          "*.js"
        ],
        "options": {
          "parser": "flow"
        }
      }
    ]
  }
}
